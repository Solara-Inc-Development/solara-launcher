{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solara Launcher",
  "mainBinaryName": "solaralauncher",
  "version": "0.0.15",
  "identifier": "in.solara.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/third-party.mjs",
    "devUrl": "http://127.0.0.1:1420/desktop.html",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "url": "desktop.html",
        "title": "Solara Launcher",
        "width": 1280,
        "height": 880,
        "minWidth": 800,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.solara-inc.in https://api.modrinth.com; img-src 'self' data: https://cdn.modrinth.com https://mc-heads.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "Solara desktop hub and Minecraft Java launcher",
    "longDescription": "Official open-source desktop launcher and mod manager for Solara Minecraft.",
    "copyright": "Copyright © 2026 Solara Inc. All rights reserved.",
    "publisher": "Solara Inc.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../../LICENSE",
      "../../THIRD_PARTY_NOTICES.md"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3OTk3QUZCNTIxMTk2MzcKUldRM2xoRlMrM3FaaDlrMDRnellrV3FJWU9ZV3Z3dW1ZZDhpSXpISk1zVExTdU1HVGlPSWUxcm8K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
