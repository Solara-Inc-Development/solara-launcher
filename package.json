{
  "name": "solara-launcher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build",
    "app:dev": "pnpm turbo run dev --filter=@modrinth/app",
    "app:build": "pnpm turbo run build --filter=@modrinth/app",
    "desktop": "pnpm --filter @modrinth/app tauri dev",
    "test": "node --test tests/*.test.mjs",
    "build:windows": "node scripts/release.mjs package",
    "release:github": "node scripts/release.mjs publish-github",
    "check": "vue-tsc --noEmit",
    "i18n:coverage": "node scripts/modrinth/run.mjs coverage-i18n --write packages/ui/src/layouts/wrapped/settings/language-settings/language-settings-coverage.generated.ts --quiet",
    "scripts": "node scripts/modrinth/run.mjs",
    "test:ui": "node scripts/check-ui.cjs",
    "test:workspace": "node scripts/check-instance-workspace.cjs",
    "test:motion": "node scripts/check-future-ui.cjs",
    "capture:preview": "node scripts/capture-preview.cjs",
    "test:workflows": "node scripts/check-workflows.cjs",
    "test:redesign": "node scripts/check-redesign.cjs",
    "test:csp": "node scripts/check-csp.cjs",
    "test:window-controls": "node scripts/check-window-controls.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.0",
    "@crowdin/crowdin-api-client": "^1.55.2",
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@modrinth/tooling-config": "workspace:*",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24",
    "@typescript-eslint/typescript-estree": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/compiler-sfc": "^3.5.43",
    "chalk": "^5.6.2",
    "playwright": "^1.64.1",
    "prettier": "^3.3.2",
    "turbo": "^2.11.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.1.0",
    "yaml": "^2.8.2"
  },
  "prettier": "@modrinth/tooling-config/prettier.config.cjs"
}
