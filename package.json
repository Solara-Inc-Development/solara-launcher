{
  "name": "solara-launcher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "tauri dev --config apps/desktop/tauri.conf.json",
    "build:windows": "node scripts/release.mjs package",
    "check": "vue-tsc --noEmit",
    "test:ui": "node scripts/check-ui.cjs",
    "test:motion": "node scripts/check-future-ui.cjs",
    "capture:preview": "node scripts/capture-preview.cjs",
    "test:workflows": "node scripts/check-workflows.cjs",
    "test:redesign": "node scripts/check-redesign.cjs",
    "test:csp": "node scripts/check-csp.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vue-tsc": "^3.1.0"
  }
}
